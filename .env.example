# GuildScribe for Discord — settings. On the Yoga laptop these live in
# /etc/tavernworks/guildscribe-discord.env (bot-host/setup.sh writes it from this file).

# Port server.ts listens on (127.0.0.1 only); the tunnel points here.
PORT=8803
# The SQLite file.
DB_PATH=./data/guildscribe-discord.sqlite
# This bot's public address (the tunnel hostname): links to the bestiary, treasury and gear pages.
PUBLIC_BASE_URL=https://guildscribe-discord.tavernworks.dev

# Discord Developer Portal → your app.
# General Information → Application ID and Public Key; Bot → Reset Token.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# AI for /haggle: OpenAI, or Ollama (OPENAI_BASE_URL=http://<ai-laptop>:11434/v1 plus OPENAI_MODEL).
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional: where /twitchinvite points (the Twitch bot's connect page).
# TWITCH_BOT_INVITE_URL=https://guildscribe.tavernworks.dev/connect

# Optional tuning, same names and defaults as the Twitch bot (see its README):
# POINTS_PER_MESSAGE=1               copper per command used
# POINTS_EARN_COOLDOWN_SECONDS=60
# HUNT_COOLDOWN_SECONDS=120
# ROB_COOLDOWN_SECONDS=300
# ROB_PROTECT_SECONDS=600
# COMMAND_COOLDOWN_MS=1200
# AUTOHUNT_CRON_MINUTES=1
# MERCHANT_CRON_MINUTES=5
